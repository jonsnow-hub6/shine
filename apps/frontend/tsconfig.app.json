{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/",
    "types": ["vite/client", "node"],

    /* React Specifics */
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "allowJs": false,

    /* Strict Type Enforcement */
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
